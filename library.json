{
    "name": "ESPressio-ESPNow",
    "description": "ESP-NOW transport and distributed ESPressio implementations for ESP32, including optional Event, Command, Security, and ESPressio-Radio integration",
    "keywords": "espnow,esp-now,esp32,wireless,peer-to-peer,clock,synchronization,event,command,security,encryption,transport,observable,threads,task,radio,espressio",
    "authors": {"name":"Simon J. Stuart","maintainer":true,"url":"https://espressio.org"},
    "homepage": "https://espressio.org",
    "build": {
        "flags": ["-std=gnu++17", "-DESPRESSIO_ESPNOW"],
        "unflags": ["-std=gnu++11"]
    },
    "repository": {"type":"git","url":"https://github.com/ESPressio-Development-Platform/ESPressio-ESP-Now.git"},
    "version": "0.8.3",
    "license": "Apache-2.0",
    "frameworks": "arduino",
    "platforms": "espressif32",
    "dependencies": [
        {
            "name":"ESPressio-System",
            "version":"https://github.com/ESPressio-Development-Platform/ESPressio-System.git#feature/1-system-memory-policy",
            "platforms":"*"
        },
        {
            "name":"ESPressio-Radio",
            "version":"https://github.com/ESPressio-Development-Platform/ESPressio-Radio.git#feature/1-radio-transport",
            "platforms":"*"
        },
        {
            "name":"ESPressio-Task",
            "version":"https://github.com/ESPressio-Development-Platform/ESPressio-Task.git#feature/1-task-execution",
            "platforms":"espressif32"
        },
        {
            "name":"ESPressio-Units",
            "version":"https://github.com/ESPressio-Development-Platform/ESPressio-Units.git#item_4_saturation_testing",
            "platforms":"*"
        },
        {
            "name":"ESPressio-Timing",
            "version":"https://github.com/ESPressio-Development-Platform/ESPressio-Timing.git#item_4_saturation_testing",
            "platforms":"espressif32"
        },
        {
            "name":"ESPressio-Observable",
            "version":"https://github.com/ESPressio-Development-Platform/ESPressio-Observable.git#feature/16-rtti-free-observer-registry",
            "platforms":"*"
        },
        {
            "name":"ESPressio-Threads",
            "version":"https://github.com/ESPressio-Development-Platform/ESPressio-Threads.git#optimisation/69-resource-footprint",
            "platforms":"espressif32"
        },
        {
            "name":"ESPressio-Event",
            "version":"https://github.com/ESPressio-Development-Platform/ESPressio-Event.git#item_4_saturation_testing",
            "platforms":"espressif32"
        },
        {
            "name":"ESPressio-Command",
            "version":"https://github.com/ESPressio-Development-Platform/ESPressio-Command.git#item_4_saturation_testing",
            "platforms":"espressif32"
        }
    ]
